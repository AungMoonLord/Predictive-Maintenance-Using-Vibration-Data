# ==============================================================================
# MechAgent Environment Variables Template
# Copy this file to .env and replace the placeholder values with your actual config.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS Credentials & Region Configuration
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Optional: Set AWS_SESSION_TOKEN if using temporary STS / SSO credentials
# AWS_SESSION_TOKEN=your_aws_session_token_here

# ------------------------------------------------------------------------------
# AWS DynamoDB Configuration
# ------------------------------------------------------------------------------
TABLE_NAME=mechagent-table

# ------------------------------------------------------------------------------
# Amazon SageMaker Serverless Inference Endpoint
# ------------------------------------------------------------------------------
SAGEMAKER_ENDPOINT_NAME=mechagent-endpoint

# ------------------------------------------------------------------------------
# Amazon Bedrock LLM Agent Configuration
# ------------------------------------------------------------------------------
# Bedrock Region (ap-southeast-1 or us-east-1)
BEDROCK_REGION=ap-southeast-1
# Model ID: apac.amazon.nova-pro-v1:0, us.amazon.nova-pro-v1:0, or anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
PRICE_IN_PER_M=0.8
PRICE_OUT_PER_M=3.2
USD_THB=35.0

# ------------------------------------------------------------------------------
# Human-in-the-Loop & Notification Settings
# ------------------------------------------------------------------------------
# Secure HMAC Secret used for 1-click email/chat approval tokens
APPROVAL_SECRET=change-this-to-a-secure-random-hmac-secret-key-32-chars

# Amazon SNS Alert Topic ARN
TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:mechagent-alerts

# Optional: Telegram Bot Notification Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Public Endpoints (Production / Deployed)
# ------------------------------------------------------------------------------
CLOUDFRONT_URL=https://d38e5nijdx3gmh.cloudfront.net
API_GATEWAY_URL=https://jynfhl5nc9.execute-api.ap-southeast-1.amazonaws.com
